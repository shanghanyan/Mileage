# Copy to .env on the VPS (never commit real values).
REMOTE_SCRAPE=1
SCRAPE_ARTIFACTS_DIR=artifacts
SCRAPE_PROXY_TYPE=vps
TOR_SOCKS=127.0.0.1:9050

# Optional: pin Chrome binary. Leave unset to auto-detect.
# CHROME_BIN=/usr/bin/google-chrome-stable
# CHROME_NO_SANDBOX=1

# Optional Tier 4 — cookies captured on the VPS, never from a laptop browser.
# SESSION_COOKIE_PATH=/home/scraper/SESSION_COOKIES/site.json

# Django export API (bind to localhost only)
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where live scrape + pytest JSON is written (relative to project root)
TEST_RESULTS_DIR=test-results
