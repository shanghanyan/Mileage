# Optional seats.aero API key (live award availability)
SEATS_AERO_API_KEY=

# Portal redemption rate: 1.0 (Venture/Quicksilver) or 1.25 (Venture X)
PORTAL_CPP=1.25

# Refuse cached data older than this many days (default 7)
MAX_CACHE_AGE_DAYS=7

# SQLite path
SQLITE_PATH=./storage/aggregator.db

# Log level
LOG_LEVEL=INFO
